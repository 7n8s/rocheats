#include <winver.h>

// Icon (lowest ID = the icon Explorer shows for the .exe)
1 ICON "app.ico"

// The RC monogram, used for the splash wordmark (packed by tools/make_icon.py)
102 RCDATA "mark.png"

// Product artwork, packed by tools/make_images.py
101 RCDATA "logos.bin"

// Application manifest (RT_MANIFEST = 24): DPI awareness, visual styles
1 24 "app.manifest"

// Version info. FileDescription is the name Windows shows on notifications.
1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "RoCheats Monitor"
            VALUE "ProductName",      "RoCheats Monitor"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "ProductVersion",   "2.0.0.0"
            VALUE "InternalName",     "RoCheatsMonitor"
            VALUE "OriginalFilename", "RoCheatsMonitor.exe"
            VALUE "Comments",         "Unofficial status monitor. Data from the public WEAO API."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
